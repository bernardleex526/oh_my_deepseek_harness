{
  "name": "dsh-multi-agent-orchestrator",
  "version": "0.1.6",
  "description": "Multi-agent coding orchestration mode for DeepSeek Harness: an Orchestrator control plane over Explorer / Librarian / Observer / Oracle / Designer / Fixer specialists with strict role, context, and permission isolation.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "multi-agent",
    "orchestration",
    "agent-preset",
    "agent",
    "subagent"
  ],
  "license": "MIT",
  "type": "module",
  "files": [
    "preset/",
    "src/",
    "prompts/",
    "scripts/",
    "tests/",
    "README.md",
    "LICENSE",
    "model-routing.json.example"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:local": "node scripts/build.mjs --local",
    "build:client": "node scripts/build-client.mjs",
    "install:client": "node scripts/install-client-plugin.mjs",
    "validate": "node scripts/validate.mjs",
    "test": "node --test",
    "smoke": "node scripts/smoke-mount.mjs",
    "install:mode": "node scripts/install.mjs",
    "status": "node scripts/orchestration-status.mjs",
    "metrics": "node scripts/orchestration-metrics.mjs",
    "prepublishOnly": "node scripts/build.mjs && node scripts/validate.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-app-boot": "0.1.0-rc.6",
    "@deepseek-ai/dsh-base": "0.1.0-rc.6",
    "@deepseek-ai/dsh-compaction-tool-result-pruner": "0.1.0-rc.6",
    "@deepseek-ai/dsh-persona": "0.1.0-rc.6",
    "@deepseek-ai/dsh-tool-ask-user": "0.1.0-rc.6",
    "@deepseek-ai/dsh-tool-subagent": "0.1.0-rc.6",
    "js-yaml": "^4.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bernardleex526/oh_my_deepseek_harness.git"
  },
  "bugs": {
    "url": "https://github.com/bernardleex526/oh_my_deepseek_harness/issues"
  },
  "homepage": "https://github.com/bernardleex526/oh_my_deepseek_harness#readme"
}
